@startuml Arquitectura_Ajedrez_Completa
title Arquitectura real del TPO de Ajedrez\nFuente: código actual. No usa el UML de octubre.

skinparam backgroundColor #F7F6F3
skinparam shadowing false
skinparam roundcorner 0
top to bottom direction
skinparam linetype polyline
skinparam nodesep 18
skinparam ranksep 28
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam packageStyle rectangle
skinparam packageFontStyle bold
skinparam ArrowColor #2C3338
skinparam ClassBorderColor #2C3338
skinparam ClassFontColor #1C1C1C
skinparam ClassAttributeFontSize 10
skinparam ClassFontSize 12
skinparam NoteBackgroundColor #FFF8E7
skinparam NoteBorderColor #B7A56A
skinparam NoteFontSize 10
skinparam classAttributeIconSize 0

skinparam class {
  BackgroundColor #FFFcf8
  BorderColor #2C3338
  HeaderBackgroundColor #F3EFE6
  BackgroundColor<<interface>> #E4EAF4
  BorderColor<<interface>> #2A4365
  HeaderBackgroundColor<<interface>> #D5E0F0
}

skinparam enum {
  BackgroundColor #F4F1EA
  BorderColor #2C3338
}

legend
|= Símbolo |= Significado |
| <<interface>> | contrato |
| triangulo punteado | implementa interfaz |
| triangulo continuo | herencia (extends) |
| rombo negro | composición: lo crea o controla su ciclo de vida |
| rombo blanco | agregación: lo referencia y puede compartirlo |
| flecha continua | asociación (atributo que guarda) |
| flecha punteada | dependencia (parámetro, creación o uso puntual) |
| <<Strategy>> | patrón Strategy |
| <<Command>> | patrón Command |
| <<State>> | patrón State |
| DI | la dependencia entra por constructor |
| <<Adapter>> | tecnología / mundo exterior |
| Núcleo | reglas de ajedrez, sin JavaFX |
endlegend

note as Direccion
  **Dirección real de los imports**
  ui ──► partida, modelo, validacion, excepciones, JavaFX
  partida ──► modelo, validacion, excepciones, JDK
  validacion ──► modelo, excepciones
  modelo ──► solo JDK
  excepciones ──► solo JDK
  ..
  El núcleo no importa JavaFX.
  Las dependencias tecnológicas apuntan hacia el núcleo.
end note

package "ajedrez.ui\nADAPTADOR DE ENTRADA" as ui <<Adapter>> #E7EEF6 {
  class AjedrezApp {
    - controlador : ControladorJuego
    - ventana : Stage <<JavaFX>>
    - vista : VistaAjedrez
    - reloj : Timeline <<JavaFX>>
    --
    + start(stage) : void
    + stop() : void
    - iniciar(config) : void
    - nuevaPartida() : void
    - pedirConfiguracion() : Optional~ConfiguracionPartida~
  }

  class VistaAjedrez {
    - controlador : ControladorJuego
    - config : ConfiguracionPartida
    - alPedirNuevaPartida : Runnable
    - seleccion : Posicion
    - destinos : List~Posicion~
    - abajo : Color
    --
    + VistaAjedrez(controlador, config, alPedirNuevaPartida)
    + getRaiz() : Parent
    + refrescar() : void
    - alHacerClic(fila, columna) : void
    - intentarMover(origen, destino) : void
    - pedirPromocion() : TipoPieza
  }

  class Main {
    + {static} main(args) : void
  }

  class ConfiguracionPartida <<record>> {
    + minutos : int
    + incrementoSegundos : int
    + girarTablero : boolean
  }

  note bottom of AjedrezApp
    Adaptador.
    El Timeline solo redibuja cada 100 ms.
    No es el Reloj del núcleo.
  end note

  note bottom of VistaAjedrez
    Adaptador JavaFX.
    Pide acciones al controlador y lee TableroConsulta.
    Detecta la fila de promoción para preguntar;
    la legalidad la decide ReglaPromocion.
    Usa instanceof Jaque solo para el texto y el color del rey.
  end note
}

package "ajedrez.partida\nNÚCLEO" as partida #FBF6EA {
  class ControladorJuego {
    - partida : Juego
    --
    + nuevaPartida(tiempo, incremento) : void
    + mover(origen, destino, promocion) : void
    + deshacer() : void
    + retroceder() : void
    + avanzar() : void
    + abandonar(color) : void
    + acordarTablas() : void
    + getEstado() : EstadoJuego
    + getTurnoActual() : Optional~Color~
    + getTablero() : TableroConsulta
    + getTableroRevision() : TableroConsulta
    + enRevision() : boolean
    + getTiempoRestante(color) : Duration
    + getPiezasCapturadas() : List~Pieza~
    + getGanador() : Optional~Color~
    + getMotivoFin() : Optional~MotivoFin~
    + movimientosLegales(origen) : List~Posicion~
  }

  class Juego {
    - tablero : Tablero
    - turnero : Turnero
    - reloj : Reloj
    - validadorJugada : ValidadorMovimiento
    - validadorJaque : ValidadorJaque
    - validadorTablas : ValidadorTablas
    - historial : HistorialComandos
    - piezasCapturadas : List~Pieza~
    - hiloReloj : HiloReloj
    - estado : EstadoJuego
    --
    + Juego(tablero, validadorJugada, validadorJaque, validadorTablas, reloj)
    + Juego(..., periodoRelojMs)
    + mover(origen, destino, promocion) : void
    + deshacer() : void
    + retroceder() : void
    + avanzar() : void
    + abandonar(color) : void
    + acordarTablas() : void
    + verificarTiempo() : void
    + detener() : void
    + getEstado() : EstadoJuego
    + getTablero() : TableroConsulta
    + getTableroRevision() : TableroConsulta
    + movimientosLegales(origen) : List~Posicion~
    ~ ejecutarJugada(jugada) : void
    ~ aplicarJugada(jugada) : Movimiento
    ~ revertirJugada(movimiento) : void
    ~ restaurarEstado(anterior) : void
    ~ deshacerUltima() : void
  }

  class Turnero {
    - turnoActual : Color
    --
    + getTurnoActual() : Color
    + esTurnoDe(color) : boolean
    + pasarTurno() : void
  }

  class Reloj {
    - restante : Map~Color, Duration~
    - incremento : Duration
    - fuenteDeTiempo : Supplier~Instant~
    - enJuego : Color
    - corriendo : boolean
    --
    + Reloj(tiempo, incremento, fuenteDeTiempo)
    + iniciar() : void
    + registrarJugada(color) : void
    + volverATurno(color) : void
    + detener() : void
    + getRestante(color) : Duration
    + tiempoAgotado() : Optional~Color~
  }

  class HiloReloj {
    - reloj : Reloj
    - juego : Juego
    - periodoMs : long
    - activo : boolean
    --
    + HiloReloj(reloj, juego, periodoMs)
    + iniciar() : void
    + run() : void
    + detener() : void
  }

  class HistorialComandos {
    - hechos : Deque~Comando~
    - rehacer : Deque~Comando~
    - tableroReal : Tablero
    - tableroRevision : Tablero
    --
    + HistorialComandos(tableroReal)
    + ejecutar(comando) : void
    + deshacer() : void
    + retroceder() : void
    + avanzar() : void
    + enRevision() : boolean
    + getTableroRevision() : TableroConsulta
    + cantidadHechas() : int
  }

  interface Comando <<Command>> {
    + ejecutar() : void
    + deshacer() : void
    + getMovimiento() : Movimiento
  }

  class ComandoMover <<Command>> {
    - juego : Juego
    - jugada : Jugada
    - movimiento : Movimiento
    - estadoAnterior : EstadoJuego
    --
    + ComandoMover(juego, jugada)
    + ejecutar() : void
    + deshacer() : void
    + getMovimiento() : Movimiento
  }

  interface EstadoJuego <<State>> {
    + mover(juego, jugada) : void
    + deshacer(juego) : void
    + siguienteTras(resultado) : EstadoJuego
    + abandonar(color) : EstadoJuego
    + acordarTablas() : EstadoJuego
    + tiempoAgotado(perdedor, rivalPuedeGanar) : EstadoJuego
    + estaTerminada() : boolean
    + getGanador() : Optional~Color~
    + getPerdedor() : Optional~Color~
    + esEmpate() : boolean
    + getMotivoFin() : Optional~MotivoFin~
  }

  class EnCurso <<State>> {
    + mover(juego, jugada) : void
    + deshacer(juego) : void
    + siguienteTras(resultado) : EstadoJuego
    + abandonar(color) : EstadoJuego
    + acordarTablas() : EstadoJuego
    + tiempoAgotado(perdedor, rivalPuedeGanar) : EstadoJuego
  }

  class Jaque <<State>> {
    + mover(juego, jugada) : void
    + deshacer(juego) : void
    + siguienteTras(resultado) : EstadoJuego
    + abandonar(color) : EstadoJuego
    + acordarTablas() : EstadoJuego
    + tiempoAgotado(perdedor, rivalPuedeGanar) : EstadoJuego
  }

  class Terminada <<State>> {
    - motivo : MotivoFin
    - ganador : Color
    --
    + Terminada(motivo, ganador)
    + mover(juego, jugada) : void
    + deshacer(juego) : void
    + estaTerminada() : boolean
    + getGanador() : Optional~Color~
    + esEmpate() : boolean
    + getMotivoFin() : Optional~MotivoFin~
    + tiempoAgotado(...) : EstadoJuego
  }

  class Transiciones {
    ~ {static} tras(resultado) : EstadoJuego
    ~ {static} porTiempo(perdedor, rivalPuedeGanar) : EstadoJuego
  }

  class ResultadoJugada <<record>> {
    + posicion : ResultadoPosicion
    + tablas : Optional~MotivoFin~
    + quienMovio : Color
    --
    + motivoFinal() : Optional~MotivoFin~
  }

  note right of ControladorJuego
    Composition root.
    Crea las implementaciones concretas
    y se las pasa a Juego.
    No es una Factory.
    No contiene JavaFX.
  end note

  note right of Juego
    Coordina la partida.
    DI por constructor: tablero,
    validadores y reloj.
    Crea adentro Turnero, HistorialComandos,
    HiloReloj y el estado EnCurso.
    validadorJugada es la interfaz.
    validadorJaque y validadorTablas
    son clases concretas.
  end note

  note bottom of ComandoMover
    Command: una jugada como objeto.
    ejecutar llama a aplicarJugada.
    deshacer llama a revertirJugada
    y restaura el estado anterior.
    Guarda el Movimiento para poder revertir.
  end note

  note bottom of HistorialComandos
    deshacer() modifica la partida real
    y descarta el comando.
    retroceder/avanzar navegan una copia.
    No son redo: no tocan turno ni reloj.
  end note

  note bottom of EstadoJuego
    State: qué operaciones admite
    la partida ahora.
    El estado devuelve el siguiente;
    no llama a un setEstado.
  end note

  note bottom of Jaque
    Cambia el mensaje si el rey sigue en peligro.
    No contiene la regla de jaque:
    esa está en ValidadorJaque.
  end note

  note bottom of Terminada
    Cambia qué operaciones están permitidas:
    mover, deshacer, abandonar y acordar
    lanzan MovimientoInvalidoException.
  end note

  note bottom of Reloj
    DI por constructor:
    Supplier~Instant~ fuenteDeTiempo.
    No termina la partida solo.
  end note

  note bottom of HiloReloj
    Mecanismo del tiempo.
    Cada periodoMs llama a
    Juego.verificarTiempo.
    No es Observer.
  end note

  note bottom of Transiciones
    Orden real: mate, ahogado,
    tablas, jaque, en curso.
    No es un patrón aparte.
    Rol: reglas de transición compartidas.
  end note
}

package "ajedrez.validacion\nNÚCLEO" as validacion #E7F2E9 {
  interface ValidadorMovimiento {
    + validar(tablero, jugada) : void
  }

  class ValidadorJugada {
    - reglas : List~ReglaMovimiento~
    --
    + ValidadorJugada(reglas)
    + validar(tablero, jugada) : void
  }

  class ValidadorJaque {
    + validar(tablero, jugada) : void
    + evaluarPosicion(tablero, color) : ResultadoPosicion
    - estaAtacada(tablero, posicion, colorAtacante) : boolean
    - estaEnJaque(tablero, color) : boolean
    - dejaEnJaque(tablero, jugada, color) : boolean
    - tieneJugadaLegal(tablero, color) : boolean
  }

  class ValidadorTablas {
    - reglas : List~ReglaTablas~
    --
    + ValidadorTablas(reglas)
    + iniciar(tablero, turno) : void
    + validar(tablero, jugada) : void
    + motivoDeTablas(tablero) : Optional~MotivoFin~
    + deshacer() : void
    + puedeGanar(tablero, color) : boolean
  }

  interface ReglaMovimiento {
    + validar(tablero, jugada) : void
  }

  class ReglaPosicionesValidas {
    + validar(tablero, jugada) : void
  }

  class ReglaMovimientoPermitido {
    + validar(tablero, jugada) : void
  }

  class ReglaPromocion {
    + validar(tablero, jugada) : void
  }

  interface ReglaTablas {
    + iniciar(tablero, turno) : void
    + registrar(movimiento, tablero, turno) : void
    + deshacer() : void
    + estaCumplida(tablero) : boolean
    + getMotivo() : MotivoFin
  }

  class ReglaCincuentaMovimientos {
    - semijugadas : int
    - anteriores : Deque~Integer~
    --
    + registrar(movimiento, tablero, turno) : void
    + deshacer() : void
    + estaCumplida(tablero) : boolean
    + getMotivo() : MotivoFin
  }

  class ReglaRepeticionTriple {
    - apariciones : Map~String, Integer~
    - claves : Deque~String~
    --
    + registrar(movimiento, tablero, turno) : void
    + deshacer() : void
    + estaCumplida(tablero) : boolean
    + getMotivo() : MotivoFin
    - generarClave(tablero, turno) : String
  }

  enum ResultadoPosicion {
    NORMAL
    JAQUE
    JAQUE_MATE
    AHOGADO
  }

  enum MotivoFin {
    JAQUE_MATE
    AHOGADO
    ABANDONO
    ACUERDO_DE_TABLAS
    TIEMPO_AGOTADO
    CINCUENTA_MOVIMIENTOS
    REPETICION_TRIPLE
    MATERIAL_INSUFICIENTE
    --
    + descripcion() : String
  }

  note bottom of ValidadorJugada
    DI por constructor: lista de reglas.
    Las recorre en orden.
    No modifica el tablero.
  end note

  note bottom of ValidadorJaque
    Regla de jaque, jaque mate y ahogado.
    Simula en una copia (simular).
    Lanza ReyEnPeligroException.
  end note

  note bottom of ValidadorTablas
    DI por constructor: lista de ReglaTablas.
    validar() registra la jugada YA hecha.
    No cumple el comentario de solo lectura
    de ValidadorMovimiento.
    El material insuficiente está en puedeGanar.
    No existe una clase ReglaMaterialInsuficiente.
  end note

  note bottom of ReglaMovimiento
    Cada regla mira una sola condición.
    No es un patrón con nombre aparte:
    es una lista intercambiable de reglas.
  end note
}

package "ajedrez.modelo\nNÚCLEO" as modelo #F3EEF8 {
  interface TableroConsulta {
    + obtenerPieza(posicion) : Pieza
    + estaOcupada(posicion) : boolean
    + estaDentro(posicion) : boolean
    + piezasDe(color) : Map~Posicion, Pieza~
    + buscarRey(color) : Posicion
    + getUltimoMovimiento() : Optional~Movimiento~
    + clasificar(jugada) : TipoMovimiento
    + simular(jugada) : TableroConsulta
  }

  class Tablero {
    - almacen : AlmacenPiezas
    - ultimoMovimiento : Movimiento
    --
    + Tablero(almacen)
    + colocarPosicionInicial() : void
    + mover(jugada) : Movimiento
    + deshacer(movimiento) : void
    + copiar() : Tablero
    + crearPieza(tipo, color) : Pieza
    + colocar(posicion, pieza) : void
    + quitar(posicion) : Pieza
    + clasificar(jugada) : TipoMovimiento
    + simular(jugada) : TableroConsulta
  }

  interface AlmacenPiezas {
    + obtener(posicion) : Pieza
    + colocar(posicion, pieza) : void
    + quitar(posicion) : Pieza
    + piezasDe(color) : Map~Posicion, Pieza~
    + copiar() : AlmacenPiezas
  }

  class AlmacenPorMapa {
    - piezas : Map~Posicion, Pieza~
    --
    + copiar() : AlmacenPiezas
  }

  class AlmacenPorMatriz {
    - casillas : Pieza[8][8]
    --
    + copiar() : AlmacenPiezas
  }

  class Pieza {
    - color : Color
    - tipo : TipoPieza
    - estrategia : EstrategiaMovimiento
    - haMovido : boolean
    --
    + Pieza(color, tipo, estrategia)
    + getTipo() : TipoPieza
    + getValor() : int
    + haMovido() : boolean
    + marcarMovida() : void
    + restaurarMovida(valor) : void
    + movimientosPosibles(origen, tablero) : List~Posicion~
    + casillasAtacadas(origen, tablero) : List~Posicion~
    + copiar() : Pieza
  }

  interface EstrategiaMovimiento <<Strategy>> {
    + movimientos(pieza, origen, tablero) : List~Posicion~
    + casillasAtacadas(pieza, origen, tablero) : List~Posicion~
  }

  class MovimientoHorizontalVertical <<Strategy>> {
    + movimientos(pieza, origen, tablero) : List~Posicion~
  }

  class MovimientoDiagonal <<Strategy>> {
    + movimientos(pieza, origen, tablero) : List~Posicion~
  }

  class MovimientoReina <<Strategy>> {
    - horizontalVertical : MovimientoHorizontalVertical
    - diagonal : MovimientoDiagonal
    --
    + movimientos(pieza, origen, tablero) : List~Posicion~
  }

  class MovimientoCaballo <<Strategy>> {
    + movimientos(pieza, origen, tablero) : List~Posicion~
  }

  class MovimientoRey <<Strategy>> {
    + movimientos(pieza, origen, tablero) : List~Posicion~
    + casillasAtacadas(pieza, origen, tablero) : List~Posicion~
    + puedeEnrocar(rey, origen, tablero, lado) : boolean
  }

  class MovimientoPeon <<Strategy>> {
    + movimientos(pieza, origen, tablero) : List~Posicion~
    + casillasAtacadas(pieza, origen, tablero) : List~Posicion~
    + capturaAlPaso(pieza, origen, tablero) : Optional~Posicion~
  }

  class Jugada <<record>> {
    + origen : Posicion
    + destino : Posicion
    + promocion : TipoPieza
  }

  class Movimiento <<record>> {
    + origen : Posicion
    + destino : Posicion
    + pieza : Pieza
    + capturada : Pieza
    + tipo : TipoMovimiento
    + promocion : TipoPieza
    + torre : Pieza
    + piezaHabiaMovido : boolean
    + torreHabiaMovido : boolean
    + ultimoAnterior : Movimiento
    --
    + comoJugada() : Jugada
  }

  class Posicion <<record>> {
    + fila : int
    + columna : int
    --
    + sumar(df, dc) : Posicion
  }

  enum Color {
    BLANCO
    NEGRO
    --
    + opuesto() : Color
  }

  enum TipoPieza {
    PEON
    CABALLO
    ALFIL
    TORRE
    REINA
    REY
    --
    - valor : int
    + getValor() : int
  }

  enum TipoMovimiento {
    NORMAL
    ENROQUE_CORTO
    ENROQUE_LARGO
    CAPTURA_AL_PASO
    PROMOCION
  }

  note bottom of TableroConsulta
    Interfaz de consulta.
    Restringe operaciones: no expone mover ni deshacer.
    No es un patrón por sí sola.
    ISP: API de lectura.
  end note

  note bottom of Tablero
    DI por constructor: AlmacenPiezas.
    Ejecuta y deshace. No valida.
    crearPieza elige la estrategia con un switch.
    DIP: depende del almacén, no del mapa ni de la matriz.
  end note

  note bottom of AlmacenPiezas
    Abstracción intercambiable de almacenamiento.
    El Tablero no conoce cómo se guardan las piezas.
    No está por performance.
  end note

  note bottom of Pieza
    Contexto de Strategy.
    Delega movimientosPosibles y casillasAtacadas.
    copiar() comparte la estrategia: no tiene estado.
  end note

  note bottom of EstrategiaMovimiento
    Strategy: encapsula distintas formas de movimiento.
    OCP: una estrategia nueva no modifica a Pieza.
    casillasAtacadas por defecto = movimientos.
    Peón y rey lo redefinen.
  end note

  note bottom of MovimientoReina
    Compone el movimiento de la torre y el del alfil.
    No duplica esas reglas.
  end note
}

package "ajedrez.excepciones" as excepciones #F8EEEE {
  class MovimientoInvalidoException {
    + MovimientoInvalidoException(motivo)
  }

  class ReyEnPeligroException {
    + ReyEnPeligroException(motivo)
  }

  note bottom of MovimientoInvalidoException
    Única herencia entre clases del TPO,
    junto con su subclase.
    Ambas extienden RuntimeException (JDK).
  end note
}

package "externos\nno son clases del TPO" as externos #F0F0F0 {
  abstract class Application <<JavaFX>> {
  }

  interface Runnable <<JDK>> {
    + run() : void
  }

  interface Supplier <<JDK>> {
    + get() : Instant
  }
}

package "ajedrez (tests)\nno es producción" as tests #F4F4F4 {
  class FakeClock {
    - ahora : Instant
    --
    + get() : Instant
    ~ avanzar(d) : void
  }

  note bottom of FakeClock
    Test double — Fake.
    Reloj controlable para tests.
    No participa de la partida real.
    Producción usa Instant::now.
  end note
}

' ----- herencia e implementación -----
AjedrezApp --|> Application
HiloReloj ..|> Runnable
FakeClock ..|> Supplier

Tablero ..|> TableroConsulta
AlmacenPorMapa ..|> AlmacenPiezas
AlmacenPorMatriz ..|> AlmacenPiezas

MovimientoHorizontalVertical ..|> EstrategiaMovimiento
MovimientoDiagonal ..|> EstrategiaMovimiento
MovimientoReina ..|> EstrategiaMovimiento
MovimientoCaballo ..|> EstrategiaMovimiento
MovimientoRey ..|> EstrategiaMovimiento
MovimientoPeon ..|> EstrategiaMovimiento

ComandoMover ..|> Comando
EnCurso ..|> EstadoJuego
Jaque ..|> EstadoJuego
Terminada ..|> EstadoJuego

ValidadorJugada ..|> ValidadorMovimiento
ValidadorJaque ..|> ValidadorMovimiento
ValidadorTablas ..|> ValidadorMovimiento

ReglaPosicionesValidas ..|> ReglaMovimiento
ReglaMovimientoPermitido ..|> ReglaMovimiento
ReglaPromocion ..|> ReglaMovimiento
ReglaCincuentaMovimientos ..|> ReglaTablas
ReglaRepeticionTriple ..|> ReglaTablas

ReyEnPeligroException --|> MovimientoInvalidoException

' ----- composición y asociación -----
AjedrezApp *-- ControladorJuego
AjedrezApp --> VistaAjedrez

VistaAjedrez --> ControladorJuego
VistaAjedrez --> ConfiguracionPartida

ControladorJuego "1" --> "0..1" Juego : partida

Juego "1" --> "1" Tablero : tablero\nDI
Juego "1" --> "1" ValidadorMovimiento : validadorJugada\nDI
Juego "1" --> "1" ValidadorJaque : DI
Juego "1" --> "1" ValidadorTablas : DI
Juego "1" --> "1" Reloj : DI
Juego "1" *-- "1" Turnero
Juego "1" *-- "1" HistorialComandos
Juego "1" *-- "1" HiloReloj
Juego "1" *-- "1" EstadoJuego : estado actual
Juego "1" *-- "0..*" Pieza : piezasCapturadas

HiloReloj --> Reloj
